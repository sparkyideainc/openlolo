[Unit]
Description=OpenLolo local control API
After=network.target NetworkManager.service avahi-daemon.service openlolo-device.service
Wants=openlolo-device.service

[Service]
Type=simple
User=openlolo
Group=openlolo
# The local captive portal binds HTTP port 80. Diagnostics export reads the service journals.
SupplementaryGroups=systemd-journal video
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/openlolo/current
ExecStart=/opt/openlolo/current/.venv/bin/openlolo --config /etc/openlolo/box.toml serve
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/openlolo /run/openlolo
InaccessiblePaths=-/run/usbmuxd
# AF_NETLINK: iw reads the radio mode and regulatory domain around the setup access point.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=256M
TasksMax=64
TimeoutStopSec=8
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
