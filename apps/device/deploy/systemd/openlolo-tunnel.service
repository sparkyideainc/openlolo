[Unit]
Description=OpenLolo remote MCP entry: Cloudflare Tunnel to the loopback OAuth gateway (ADR 0003)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Written by scripts/remote-access.sh: cloudflared.yml holds the tunnel id, credentials path and
# ingress (locally managed), or tunnel.env holds TUNNEL_TOKEN (dashboard-managed).
EnvironmentFile=-/etc/openlolo/tunnel.env
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/openlolo/cloudflared.yml tunnel run
# cloudflared keeps outbound HTTP/2 connections to Cloudflare's edge. They are bound to the
# address they were opened from and go silent after an interface change until cloudflared's own
# timeout (ADR 0003, amendment 2026-09-30); Restart covers process death only.
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=32
TimeoutStopSec=8
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
