{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"portal#build": {
			"dependsOn": ["^build"],
			"outputs": ["../device/src/openlolo/web/portal/**"]
		}
	},
	"globalEnv": ["CI", "NODE_ENV", "VITE_SERVER_URL"],
	"globalDependencies": [".env*", "apps/*/.env*"]
}
